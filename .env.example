# Solana Program ID (Deployed on Devnet)
NEXT_PUBLIC_PROGRAM_ID=BN6Zt6ctB4B5dTs8myMrq6CUp5Lea7jMitG9bp8cGKuA

# Recommended: Dedicated Helius / QuickNode Devnet RPC URL
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Supabase Public Browser Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Supabase Server Service Role Key (required to upload ElevenLabs MP3 alerts to `stream-alerts` storage)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Server PostgreSQL Connection String (prefer a least-privilege role, not postgres superuser)
DATABASE_URL=postgresql://solstream_app:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Required for verified PostgreSQL TLS on hosted Supabase pooler: PEM contents (DATABASE_SSL_CA) or file path (PGSSLROOTCERT). Never commit .crt/.pem files.
DATABASE_SSL_CA=
PGSSLROOTCERT=

# Optional: ElevenLabs API Key for server-side AI voice alert generation inside /api/tips/verify
ELEVENLABS_API_KEY=

# Required to enable /api/tips/recover (fails closed with 503 if unset; Authorization: Bearer <secret> or x-recovery-secret)
SOLSTREAM_RECOVERY_SECRET=

# Optional: Max confirmed signatures to scan per creator when paginating getSignaturesForAddress (default 40, max 500)
SOLSTREAM_SIG_FETCH_CAP=40

# Optional: Firecrawl API key for channel URL auto-fill on /claim (POST /api/creators/import-profile)
FIRECRAWL_API_KEY=
